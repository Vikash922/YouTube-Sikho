{
  "name": "youtube-sikho-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev:all": "bash scripts/start-all.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\" --quiet",
    "lint:tokens": "node scripts/test-no-hardcoded-colors.js",
    "lint:contrast": "node scripts/test-contrast.js",
    "lint:i18n": "node scripts/check-i18n-parity.js",
    "lint:secrets": "node scripts/pre-commit-secret-scan.js --all",
    "lint:rules": "node scripts/test-firestore-rules.js",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node scripts/test-rules-emulator.js\"",
    "doctor": "npx --yes expo-doctor",
    "export:android": "npx expo export --platform android --no-bytecode",
    "build": "npm run export:android",
    "verify": "node scripts/verify-pipeline.js",
    "test": "node scripts/run-all-tests.js",
    "test:motion": "node scripts/e2e-motion-test-runner.js",
    "test:contrast": "node scripts/test-contrast.js",
    "i18n:check": "node scripts/check-i18n-parity.js",
    "secret:scan": "node scripts/pre-commit-secret-scan.js --all",
    "backup:firestore": "node scripts/backup-firestore.js",
    "check": "node scripts/test-contrast.js && node scripts/test-no-hardcoded-colors.js && node scripts/test-accessibility.js && npm --prefix functions test",
    "e2e": "maestro test e2e/flows",
    "client:use": "node scripts/client-manager.js use",
    "client:validate": "node scripts/client-manager.js validate",
    "client:new": "node scripts/client-manager.js new",
    "client:setup": "node scripts/client-manager.js setup",
    "build:client": "node scripts/client-manager.js build",
    "deploy:admin": "node scripts/client-manager.js deploy-admin",
    "deploy:backend": "node scripts/client-manager.js deploy-backend"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.35.0",
    "expo": "^58.0.19",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-screen-capture": "~58.0.6",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "firebase": "^10.12.0",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^0.383.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
