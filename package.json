{
  "name": "youtube-sikho-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "gateway": "cd gateway && YOUPI_ALLOW_LOCALHOST_MODE=true YOUPI_MODE=localhost node scripts/start.js",
    "dev:all": "bash scripts/start-all.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/test-no-hardcoded-colors.js",
    "doctor": "npx expo-doctor",
    "test": "node scripts/run-all-tests.js",
    "test:contrast": "node scripts/test-contrast.js",
    "check": "node scripts/test-contrast.js && node scripts/test-no-hardcoded-colors.js && node scripts/test-accessibility.js && node scripts/test-firestore-rules.js && node scripts/test-cloud-functions.js",
    "e2e": "maestro test e2e/flows",
    "client:use": "node scripts/client-manager.js use",
    "client:new": "node scripts/client-manager.js new",
    "build:client": "node scripts/client-manager.js build",
    "deploy:admin": "node scripts/client-manager.js deploy-admin",
    "deploy:backend": "node scripts/client-manager.js deploy-backend"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.35.0",
    "expo": "^58.0.19",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-screen-capture": "~58.0.6",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "firebase": "^10.12.0",
    "lucide-react-native": "^0.383.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
