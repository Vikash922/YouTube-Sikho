{
  "name": "youtube-sikho-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "gateway": "cd gateway && YOUPI_ALLOW_LOCALHOST_MODE=true YOUPI_MODE=localhost node scripts/start.js",
    "dev:all": "bash scripts/start-all.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/test-no-hardcoded-colors.js",
    "doctor": "npx expo-doctor",
    "test": "node scripts/run-all-tests.js",
    "test:contrast": "node scripts/test-contrast.js",
    "check": "node scripts/test-contrast.js && node scripts/test-no-hardcoded-colors.js && node scripts/test-accessibility.js && node scripts/test-firestore-rules.js && node scripts/test-cloud-functions.js",
    "e2e": "maestro test e2e/flows",
    "client:use": "node scripts/client-manager.js use",
    "client:new": "node scripts/client-manager.js new",
    "build:client": "node scripts/client-manager.js build",
    "deploy:admin": "node scripts/client-manager.js deploy-admin",
    "deploy:backend": "node scripts/client-manager.js deploy-backend"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@tanstack/react-query": "^5.35.0",
    "expo": "~51.0.0",
    "expo-blur": "~13.0.2",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.7",
    "expo-haptics": "~13.0.1",
    "expo-image": "~1.12.12",
    "expo-image-picker": "~15.0.5",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.15",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.6",
    "firebase": "^10.12.0",
    "lucide-react-native": "^0.383.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-webview": "^14.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3"
  },
  "private": true
}
