rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'owner')
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSafeImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isSafeDocument() {
      return request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/.*)');
    }

    // 1. User Profile Avatars
    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if (isOwner(uid) || isAdmin()) && isSafeImage();
    }

    // 2. Course Thumbnails, Category Icons & Banners (Public Read, Admin Write)
    match /courses/{courseId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImage();
    }

    match /categories/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImage();
    }

    match /banners/{bannerId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isSafeImage();
    }

    // 3. Course Study Materials & PDF Notes
    // Students access materials securely via signed URLs generated by the getMaterialUrl Cloud Function.
    // Direct client read & write in storage is restricted to Admins.
    match /materials/{courseId}/{fileName} {
      allow read, write: if isAdmin() && isSafeDocument();
    }

    // 4. Default Deny Catch-All
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
