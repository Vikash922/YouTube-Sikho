{
  "name": "course-app-functions",
  "version": "1.0.0",
  "description": "Production hardened Cloud Functions for YouTube Sikho Course App",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:all": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "tsc && node --test lib/__tests__/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "razorpay": "^2.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
