rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Architecture (Phase 4 Production Hardened)
    // ===============================================================
    // - /categories/{categoryId}
    // - /courses/{courseId}
    //   - /sections/{sectionId}
    //     - /lessons/{lessonId}
    // - /banners/{bannerId}
    // - /homeSections/{sectionId}
    // - /appConfig/{configDoc}
    // - /admins/{uid}
    // - /users/{uid}
    // - /progress/{progressId}
    // - /enrollments/{enrollmentId} (Cloud Functions / Admin locked)
    // - /orders/{orderId} (Cloud Functions / Admin locked)
    // - /coupons/{couponCode} (Admin managed, Student read)
    // - /liveClasses/{classId} (Admin managed, Public/Student read)
    //   - /messages/{messageId} (Rate-limited, Student chat, Admin moderate)
    // - /notifications/{notificationId} (Admin broadcast history)
    // - /userNotifications/{uid}/items/{itemId} (Owner-isolated notification center)
    // - /quizzes/{quizId} (Metadata read by student)
    //   - /questions/{questionId} (CRITICAL: Admin/Functions ONLY, student direct read DENIED)
    // - /quizResults/{resultId} (Cloud Functions / Admin locked, Student read own)
    // - /reviews/{reviewId} (Student review, Admin hide toggle)
    // - /tickets/{ticketId} (Owner or Admin support tickets)
    // - /faqs/{faqId} (Admin managed, Public read)
    // - /materials/{materialId} (Course study material notes/PDFs)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'owner')
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ===============================================================
    // 1. ADMINS COLLECTION
    // ===============================================================
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 2. CATEGORIES
    // ===============================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 3. COURSES, SECTIONS & LESSONS
    // ===============================================================
    match /courses/{courseId} {
      allow read: if (resource == null || resource.data.isPublished == true) || isAdmin();
      allow create, update, delete: if isAdmin();

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // ===============================================================
    // 4. BANNERS (Home Manager)
    // ===============================================================
    match /banners/{bannerId} {
      allow read: if (resource == null || resource.data.active == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 5. HOME SECTIONS (Dynamic Home Manager)
    // ===============================================================
    match /homeSections/{sectionId} {
      allow read: if (resource == null || resource.data.isVisible == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 6. APP CONFIGURATION (Maintenance, Brand Settings)
    // ===============================================================
    match /appConfig/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 7. USER PROFILE & USER SUBCOLLECTIONS (Strict PII Isolation & Field Lock)
    // ===============================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Owner can create own profile document with strictly allowed non-privilege fields
      allow create: if (
        isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'email', 'photoUrl', 'language',
          'notificationPreferences', 'fcmToken', 'fcmTokenUpdatedAt',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100)) &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
      ) || isAdmin();

      // Owner can update only profile fields; isBlocked, role, claims & admin flags are NEVER owner-writable
      allow update: if (
        isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'email', 'photoUrl', 'language',
          'notificationPreferences', 'fcmToken', 'fcmTokenUpdatedAt', 'updatedAt'
        ]) &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100)) &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
      ) || isAdmin();

      // Delete permitted exclusively via deleteAccount Cloud Function (Admin SDK)
      allow delete: if false;

      match /{allUserPaths=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ===============================================================
    // 8. WATCH PROGRESS
    // ===============================================================
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 9. STUDENT ENROLLMENTS (Cloud Functions Protected)
    // ===============================================================
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 10. ORDERS & BILLING (Cloud Functions Protected)
    // ===============================================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 11. DISCOUNT COUPONS (Admin Managed, Student Checkout Read)
    // ===============================================================
    match /coupons/{couponCode} {
      allow read: if isAuthenticated() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 12. LIVE CLASSES & REAL-TIME CHAT (Phase 4 Hardened)
    // ===============================================================
    match /liveClasses/{classId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Real-time Chat Room Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() || isAdmin();
        allow create: if isAuthenticated() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 300;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      }

      // Real-time Hand Raises Subcollection
      match /handRaises/{raiseId} {
        allow read, write: if isAuthenticated() || isAdmin();
      }

      // WebRTC Live Video Signaling Subcollection
      match /viewers/{viewerId} {
        allow read, write: if true;
        match /{allViewerSubpaths=**} {
          allow read, write: if true;
        }
      }
    }

    // ===============================================================
    // 13. PUSH NOTIFICATIONS & USER IN-APP NOTIFICATION CENTER (Phase 4)
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /userNotifications/{uid}/items/{itemId} {
      // User can read and swipe-to-delete only their own notifications
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      // Allow user to mark as read or update their own notification item
      allow update: if (isOwner(uid) || isAdmin());
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ===============================================================
    // 14. QUIZZES, EVALUATION & RESULTS (Phase 4)
    // ===============================================================
    match /quizzes/{quizId} {
      // Students can read quiz metadata (title, duration, passMarks)
      allow read: if isAuthenticated() || isAdmin();
      allow create, update, delete: if isAdmin();

      // CRITICAL SECURITY: Questions subcollection contains correct answers and explanations.
      // Must NEVER be readable directly by students. Only Admin & Cloud Functions.
      match /questions/{questionId} {
        allow read, write: if isAdmin();
      }
    }

    match /quizResults/{resultId} {
      // Students can read only their own evaluated quiz result
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      // Results MUST be evaluated server-side and written by Cloud Functions/Admin
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 15. STUDENT REVIEWS & COURSE RATINGS
    // ===============================================================
    match /reviews/{reviewId} {
      // Public can read reviews unless hidden by admin
      allow read: if (resource == null || resource.data.isHidden != true) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // ===============================================================
    // 16. SUPPORT TICKETS & FAQS (Phase 4)
    // ===============================================================
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    match /faqs/{faqId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 17. STUDY MATERIALS & PDF NOTES (Phase 4)
    // ===============================================================
    match /materials/{materialId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    // ===============================================================
    // DEFAULT DENY FOR ANY UNMATCHED PATH
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
