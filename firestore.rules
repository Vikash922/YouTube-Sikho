rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'owner') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isEnrolled(courseId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)) &&
        get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active'
      );
    }

    // ===============================================================
    // 1. ADMINS COLLECTION
    // ===============================================================
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // 2. CATEGORIES
    // ===============================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 3. COURSES, SECTIONS, LESSONS & PRIVATE MEDIA
    // ===============================================================
    match /courses/{courseId} {
      allow read: if (resource == null || resource.data.isPublished == true) || isAdmin();
      allow create, update, delete: if isAdmin();

      match /sections/{sectionId} {
        allow read: if (get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true) || isAdmin();
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if (get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true) || isAdmin();
          allow write: if isAdmin();

          match /private/{docId} {
            // Admin only! Never readable by clients.
            allow read, write: if isAdmin();
          }
        }
      }
    }

    // ===============================================================
    // 4. BANNERS (Home Manager)
    // ===============================================================
    match /banners/{bannerId} {
      allow read: if (
        resource == null ||
        resource.data.isVisible == true ||
        resource.data.active == true
      ) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 5. HOME SECTIONS (Dynamic Home Manager)
    // ===============================================================
    match /homeSections/{sectionId} {
      allow read: if (resource == null || resource.data.isVisible == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 6. APP CONFIGURATION (Maintenance, Brand Settings)
    // ===============================================================
    match /appConfig/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 7. USER PROFILE & USER SUBCOLLECTIONS (Strict PII Isolation & Field Lock)
    // ===============================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if (
        isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'email', 'photoUrl', 'language',
          'notificationPreferences', 'fcmToken', 'fcmTokenUpdatedAt',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100)) &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
      ) || isAdmin();

      allow update: if (
        isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'email', 'photoUrl', 'language',
          'notificationPreferences', 'fcmToken', 'fcmTokenUpdatedAt', 'updatedAt'
        ]) &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100)) &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20)) &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
      ) || isAdmin();

      allow delete: if false;

      match /{allUserPaths=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ===============================================================
    // 8. WATCH PROGRESS
    // ===============================================================
    match /progress/{progressId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ===============================================================
    // 9. STUDENT ENROLLMENTS (Cloud Functions Protected - Admin SDK Only)
    // ===============================================================
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 10. ORDERS & BILLING (Cloud Functions Protected - Admin SDK Only)
    // ===============================================================
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 11. DISCOUNT COUPONS (Admin Managed, Server Validated)
    // ===============================================================
    match /coupons/{couponCode} {
      allow read: if isAdmin(); // Validated server-side via validateCoupon callable
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 12. LIVE CLASSES & REAL-TIME CHAT
    // ===============================================================
    match /liveClasses/{classId} {
      allow read: if isSignedIn() || isAdmin();
      allow create, update, delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() || isAdmin();
        allow create: if isSignedIn() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 300;
        allow update: if isAdmin(); // Prevent message tampering / impersonation
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }

      match /handRaises/{uid} {
        allow read: if isSignedIn() || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }

      match /viewers/{viewerId} {
        allow read, write: if false; // Disallow raw WebRTC signaling leakage
      }
    }

    // ===============================================================
    // 13. PUSH NOTIFICATIONS & USER NOTIFICATION CENTER
    // ===============================================================
    match /notifications/{notificationId} {
      allow read, write: if isAdmin(); // Internal broadcast log
    }

    match /userNotifications/{uid}/items/{itemId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ===============================================================
    // 14. QUIZZES, QUESTIONS & RESULTS
    // ===============================================================
    match /quizzes/{quizId} {
      allow read: if isSignedIn() || isAdmin();
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow read, write: if isAdmin(); // Anti-cheat: students evaluate via submitQuiz Cloud Function
      }
    }

    match /quizResults/{resultId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 15. STUDENT REVIEWS & COURSE RATINGS
    // ===============================================================
    match /reviews/{reviewId} {
      allow read: if (resource == null || resource.data.isHidden != true) || isAdmin();
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.uid) &&
        isEnrolled(request.resource.data.courseId);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ===============================================================
    // 16. SUPPORT TICKETS & FAQS
    // ===============================================================
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(request.resource.data.uid) && request.resource.data.status == 'open';
      allow update: if isAdmin(); // Students cannot change status or assign tickets
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/tickets/$(ticketId)).data.uid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && (get(/databases/$(database)/documents/tickets/$(ticketId)).data.uid == request.auth.uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    match /faqs/{faqId} {
      allow read: if (resource == null || resource.data.isPublished == true) || isAdmin();
      allow write: if isAdmin();
    }

    // ===============================================================
    // 17. STUDY MATERIALS & PDF NOTES
    // ===============================================================
    match /materials/{materialId} {
      allow read: if isSignedIn() && (isAdmin() || (resource.data.courseId != null && isEnrolled(resource.data.courseId)));
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 18. CERTIFICATES (Public Verification, Server-Authoritative)
    // ===============================================================
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 19. INTERNAL AUDIT LOGS & PROCESSED EVENTS
    // ===============================================================
    match /processedEvents/{eventId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===============================================================
    // 20. ANALYTICS & TRANSACTIONAL MAIL
    // ===============================================================
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // DEFAULT DENY CATCH-ALL
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
